# Copy this file to ".env" (same folder) and paste your own key.
# Get a free key at https://console.groq.com/keys
# Also open https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# once and accept the terms, or voice replies will fail.
GROQ_API_KEY=gsk_your_key_here

# Optional settings
# PORT=5000
# DISCOVERY_PORT=5001
# LANGUAGE=en
# CHAT_MODEL=openai/gpt-oss-20b
# TTS_VOICE=austin
# Only answer when the sentence contains this word (ignores people talking nearby).
# Extra comma-separated spellings catch Whisper's misspellings.
# WAKE_WORD=jarvis,jervis,javis,travis,jarvas
# Keep every recording in server/recordings/ (for tuning)
# SAVE_RECORDINGS=1
